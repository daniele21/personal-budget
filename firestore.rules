rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
             && request.auth.token.email in [
               'danielemoltisanti@gmail.com',
               'staituned.owner@gmail.com'
             ];
    }

    // ── allowedUsers ──────────────────────────────────────────────
    // Any authenticated user can read (to check if their own hash exists).
    // Only designated admins can write (add/remove users); their email
    // identity is verified from the Firebase Authentication token.
    match /allowedUsers/{hash} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    // ── backups ─────────────────────────────────────────────────────
    // Each user can read/write only their own encrypted backup doc.
    match /backups/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // ── geminiConfig ────────────────────────────────────────────────
    // Admin can read/write the active model selection.
    // All authenticated users can read (to know which model to use).
    match /geminiConfig/{docId} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    // ── geminiUsage ─────────────────────────────────────────────────
    // Any authenticated user can create usage records (logged on AI calls).
    // Only the admin can read all records (monitoring dashboard).
    match /geminiUsage/{docId} {
      allow create: if request.auth != null;
      allow read:   if isAdmin();
    }

    // ── Default: deny everything else ─────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
