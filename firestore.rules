rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── allowedUsers ──────────────────────────────────────────────
    // Any authenticated user can read (to check if their own hash exists).
    // Only the admin can write (add/remove users) via the app;
    // the admin email hash is verified server-side in app logic.
    match /allowedUsers/{hash} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.email == 'danielemoltisanti@gmail.com';
    }

    // ── backups ─────────────────────────────────────────────────────
    // Each user can read/write only their own encrypted backup doc.
    match /backups/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // ── geminiConfig ────────────────────────────────────────────────
    // Admin can read/write the active model selection.
    // All authenticated users can read (to know which model to use).
    match /geminiConfig/{docId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.email == 'danielemoltisanti@gmail.com';
    }

    // ── geminiUsage ─────────────────────────────────────────────────
    // Any authenticated user can create usage records (logged on AI calls).
    // Only the admin can read all records (monitoring dashboard).
    match /geminiUsage/{docId} {
      allow create: if request.auth != null;
      allow read:   if request.auth != null
                    && request.auth.token.email == 'danielemoltisanti@gmail.com';
    }

    // ── Default: deny everything else ─────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
